# Puerto local
PORT=8081
NODE_ENV=development
LOG_LEVEL=info

# Google OAuth (obtener en console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT propio (cualquier string secreto largo)
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Frontend
FRONTEND_URL=http://localhost:3030

# CORS
ALLOWED_ORIGINS=http://localhost:3030,http://localhost:3000

# PostgreSQL local
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hipotecai
DB_PORT=5432

# Cloud Run / Cloud SQL (sólo en producción)
# K_SERVICE=login-service
# INSTANCE_CONNECTION_NAME=project:region:instance

# Bypass auth en local (solo desarrollo)
SKIP_AUTH=false
